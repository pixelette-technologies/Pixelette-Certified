RESEND_API_KEY=re_your_resend_api_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key
ALICE_ADMIN_EMAIL=admin@yourdomain.com
ALICE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
ALICE_RATE_LIMIT_ENABLED=true
# Set to "true" to enable /api/alice/*-test diagnostic routes. Leave as "false" or remove in production.
ALICE_DEV_ENDPOINTS_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Set to "true" to enable Cloudflare Turnstile CAPTCHA on first messages. Set to "false" to disable for local testing.
ALICE_TURNSTILE_ENABLED=true

# --- Contact form governance ---
# Rate limiting on /api/contact is ON by default; set to "false" to disable.
CONTACT_RATE_LIMIT_ENABLED=true
# Enable Cloudflare Turnstile verification on the contact form. Reuses the
# TURNSTILE_SECRET_KEY / NEXT_PUBLIC_TURNSTILE_SITE_KEY above. Leave unset/"false"
# and the form still validates, rate-limits, and records consent — just without
# Turnstile.
CONTACT_TURNSTILE_ENABLED=true

# Weekly report recipient (Rana's email)
WEEKLY_REPORT_EMAIL=rana@pixelettegroup.com

# Secret for securing Vercel Cron endpoints
CRON_SECRET=your-random-secret-string-here

# --- Contact form attachments ---
# Private Supabase Storage bucket holding optional enquiry attachments. Use a
# DISTINCT bucket per environment so preview traffic never lands customer
# documents in the production bucket.
CONTACT_ATTACHMENTS_BUCKET=contact-attachments
# Lifetime of the signed download link placed in the admin notification email.
# 7 days: partnerships may not action a lead for several days, so a 1-hour link
# generates support friction, while a longer one widens the window if the email
# is forwarded or the mailbox is later compromised.
CONTACT_ATTACHMENT_URL_TTL_SECONDS=604800
# Rollout switch for the optional upload. This is NOT a security control: size,
# type, magic-byte and Turnstile-ordering checks all run unconditionally, so
# flipping this can never weaken how an upload is handled. It only decides
# whether the form offers one.
NEXT_PUBLIC_CONTACT_UPLOADS_ENABLED=true
