{
  "name": "pixelette-certified",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-claims.mjs && npm run pix:check && npm run check:pix-sources && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:legacy-tokens": "node scripts/check-legacy-tokens.mjs",
    "lint:claims": "node scripts/check-claims.mjs",
    "verify": "npm run lint && npm run lint:legacy-tokens && npm run lint:claims && npm run pix:check && npm run check:pix-sources && npm run pix:test && tsc --noEmit",
    "compare:palette": "node scripts/build-palette-compare.mjs",
    "pix:build": "node scripts/build-pix-kb.mjs",
    "pix:check": "node scripts/check-pix-kb.mjs",
    "pix:test": "node scripts/test-pix.cjs",
    "check:pix-sources": "node scripts/check-pix-kb-sources.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.0",
    "@supabase/supabase-js": "^2.101.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
